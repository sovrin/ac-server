{
    "name": "ac-server",
    "version": "0.0.0",
    "keywords": [],
    "license": "MIT",
    "author": {
        "name": "Oleg Kamlowski",
        "email": "oleg.kamlowski@thomann.io"
    },
    "files": [
        "src",
        "README.md"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsx watch src/index.ts",
        "watch": "tsdown --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:types": "attw --pack .",
        "coverage": "vitest run --coverage",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix"
    },
    "dependencies": {
        "express": "^5",
        "lowdb": "^7",
        "ws": "^8",
        "zod": "^4"
    },
    "devDependencies": {
        "@eslint/js": "^9",
        "@types/express": "^5",
        "@types/node": "^25",
        "@types/ws": "^8",
        "@typescript-eslint/eslint-plugin": "^8",
        "@typescript-eslint/parser": "^8",
        "@vitest/coverage-istanbul": "^4.0.16",
        "@vitest/coverage-v8": "^4",
        "eslint": "^9",
        "oxfmt": "^0.35.0",
        "oxlint": "^1.50.0",
        "tsdown": "^0.20",
        "tsx": "^4",
        "typescript": "^5",
        "typescript-eslint": "^8",
        "vitest": "^4"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.8.0"
    }
}
